# Serve .mjs as JavaScript.
#
# MapLibre's worker ships as an ES module (maplibre-gl-worker.mjs) and is
# started with `new Worker(url, { type: 'module' })`. A module worker is
# REJECTED unless the response carries a JavaScript MIME type, and Apache does
# not map .mjs on every host. Without this the worker fails to start, and the
# failure is silent in a way that looks nothing like its cause: raster imagery
# still draws, so the basemap looks fine, while every GeoJSON source yields
# zero tiles and the map appears to have no data on it.
<IfModule mod_mime.c>
    AddType text/javascript .mjs

    # The web app manifest. Apache does not map .webmanifest by default, and a
    # manifest served as octet-stream is ignored — with no console error and no
    # symptom beyond an install option that never appears.
    AddType application/manifest+json .webmanifest
</IfModule>

# Never let the service worker go stale.
#
# A cached sw.js is a cached set of caching rules: if this file is held by the
# browser or an intermediary, a fix to what may be stored — the thing standing
# between one farmer's records and the next person to pick up the phone — would
# not reach devices until the copy expired. Browsers already bypass the HTTP
# cache for worker updates, but that behaviour is recent enough to be worth
# stating rather than relying on.
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
